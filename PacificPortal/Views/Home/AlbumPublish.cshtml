@{
    ViewBag.Title = "Pacific Jeans Group - Album";
}

<style>
    body{
        margin-top:80px;    
    }


    input {
        /*max-width:400px;*/
    }
    .error {
        color: red;
    }

    

                        </style>
              




<div ng-controller="AlbumPublishController"  class="container" prevent-right-click="YSN_preventRightClick" >


    
     


   <div class="panel panel-info" >


       

       <div class="panel-heading" style="min-height:20px">

       
            <span style="color:#1f530d;font-size:12px">    <i class="glyphicon glyphicon-hand-right"></i> Pacific Album </span>
          

        @{
            if (ViewBag.AlbumGroup != null)
            {
                var AlbumGroup = ViewBag.AlbumGroup as IEnumerable<PacificPortal.Models.tblAlbumGroup>;
                  @AlbumGroup.FirstOrDefault().GroupName
            <input   type="hidden"  ng-init="AlbumID = '@AlbumGroup.FirstOrDefault().ID'" ng-model="AlbumID"  />
            <input   type="hidden"  ng-init="AlbumSecurityCode = '@AlbumGroup.FirstOrDefault().SecurityCode'" ng-model="AlbumSecurityCode"  />
            
            }
           
            }

            </div>

            <!-- Modal --> <!-- --------------------------  New Album --------------------------------- -->
     

          <div class="modal fade" id="ModalAlbumNew" role="dialog"  >
            <div class="modal-dialog">
                  <div class="col-sm-10 col-sm-offset-3">
               <div class="panel panel-info" >
                   
                    <div class="panel-heading" style="text-align:center">
                        <button type="button" class="close" data-dismiss="modal" >&times;</button>
                          
                       Security Code
                        
                                           
                    </div>

                    <div class="modal-body">

      
                         <form novalidate name="f1" ng-submit="CheckAlbumSecurityCode(Album)" >   
        
                        <div class="form-group">
                            <label class="text text-info">Code: </label>                              
                            <input  type="password" ng-model="Album.AlbumSecurityCode" class="form-control" name="AlbumSecurityCode"/>
                            <span class="error col-md-offset-2" ng-show="(f1.AlbumSecurityCode.$dirty || submitted) && f1.AlbumSecurityCode.$error.required">Reasons require</span>
                        </div>
                         

                        </div> 


                        <div class="text-center"> 
                             <input type="submit" class="btn btn-primary" value="Login"  />             
                        </div>
                
        </form>
                        
                    </div>
                    
                </div>
                       </div>
            </div>


   <div class="panel-body" infinityscroll="NextLoad()" style="height:550px; overflow:auto;">
       <div class="col-md-3 col-sm-6" >
          </div>
         <div class="col-md-6 col-sm-6" >
     
                       
    @*<label for="primary" class="btn btn-info">Level <input type="checkbox" ng-change="DesigShowChange()" ng-model="DesigShow" id="primary" class="badgebox"><span class="badge">&check;</span></label>
   *@
 
   
    @*  <div  class="col-xs-12" ng-repeat="(key,value) in (results_groupBy  = (AlbumDetailList |   orderBy : '-SnapDate'|   filter: search))|   orderBy : '-SnapDate'|  groupBy:'SnapDate' ">
      
      
            </br>
              <label for="primary" class="btn btn-info">Date :<span class="badge">{{key.slice(6,-2)|date:'dd-MM-yyyy'}}</span></label>
   
                  </br>*@

        
  <div id="rowSearchData"   ng-repeat="AlbumDetail in AlbumDetailList|  orderBy : '-SnapDate'" >
       </br>


            <span style="color:#1f530d;font-size:12px">    <i class="glyphicon glyphicon-plus"></i> {{AlbumDetail.SnapDate.slice(6,-2)|date:'dd-MM-yyyy'}}   </span>
            </br>
            <span style="color:#1f530d;font-size:14px">       <i class="glyphicon glyphicon-hand-right"></i> {{AlbumDetail.Name}}</span>
            </br>             
            <span style="color:#091f72">{{AlbumDetail.Description}}</span> 
      
       
           @*   <label for="primary" class="btn btn-info">Date :<span class="badge">{{AlbumDetail.SnapDate.slice(6,-2)|date:'dd-MM-yyyy'}}</span></label>
    <h5><span style="padding-left:10px;">{{AlbumDetail.Name}}</span></h5> *@ 
     

   @*entrepreneurs   ng-src="../images/album/blank-picture.png"*@
      <img  check-image  ng-src="@Url.Action("GetImg")?imageURL={{AlbumDetail.TemplateImage}}"  ng-click="SlideShow(AlbumDetail)"  class="card-img-top img-rounded img-responsive" style="margin:0 auto;cursor: pointer;" alt="Album Image" min-width="150" min-height="150"> 
       
       
           

  </div>


    


 @* row end*@
  </div>

            
 @* <div  id="preloader" >
      Hello
       </div>*@

        @*id="{{AlbumDetail.RegId+'ModalShowImageSlide'}}"*@
             <!-- Modal --> <!-- --------------------------ModalShowImageSlide--------------------------------- -->
            @*<div class="modal fade modal-fullscreen" id="ModalShowImageSlide"  role="dialog"  >
            <div class="modal-dialog">*@
                     <div class="modal fade" id="ModalShowImageSlide"  role="dialog"  >
              <div class="modal-dialog modal-lg">
               <div class="panel panel-info"  >
                    <div class="panel-heading" style="text-align:center">
                        <button type="button" class="close" data-dismiss="modal" >&times;</button>
                          
                        {{Album.Name}}
                      
                                           
                    </div>
                    <div class="modal-body2">                       

                        <div id='carousel-custom' ng-if="viewLoaded" class='carousel slide' data-ride='carousel'>

           

    <div class='carousel-outer'>
          

        <!-- Wrapper for slides -->
        <div class='carousel-inner'>
          @*
            <div class='item active'>
                <img src='http://azoom-sites.rockthemes.net/abboxed/wp-content/uploads/sites/14/2015/05/abboxed-restaurant-portfolio2.jpg' alt='' />
            </div>
            
            <div class='item'>
                <img src='http://azoom-sites.rockthemes.net/abboxed/wp-content/uploads/sites/14/2015/05/abboxed-beach-portfolio.jpg' alt='' />
            </div>*@
            <div ng-class="({{$index}}==0) ? 'item active':'item'"   ng-repeat="image_urls in AlbumImagesList" >
                
               

                 
                @*<img src='{{image_urls}}' alt='' />*@
                 <img src="@Url.Action("GetImg")?imageURL={{image_urls}}"  />
                     
            </div>
                
           
        </div>
            
        <!-- Controls -->

         
        <a class='left carousel-control' href='#carousel-custom' data-slide='prev'>
           <span class="icon-prev" aria-hidden="true"></span>
        			<span class="sr-only">Previous</span>
        </a>
        <a class='right carousel-control' href='#carousel-custom' data-slide='next'>
          <span class="icon-next" aria-hidden="true"></span>
        			<span class="sr-only">Next</span>
        </a>

       

    </div>
    
    <!-- Indicators -->
    <ol class='carousel-indicators mCustomScrollbar'>
       @* <li data-target='#carousel-custom' data-slide-to='0' class='active'><img src='http://placehold.it/100x50&text=slide1' alt='' /></li>
        
        <li data-target='#carousel-custom' data-slide-to='1'><img src='http://placehold.it/100x50&text=slide2' alt='' /></li>*@
        

        <li data-target='#carousel-custom' ng-class="({{$index}}=={{$index}}) ? 'active'" data-slide-to='{{$index}}' ng-repeat="image_urls in AlbumImagesList">
             <img src="@Url.Action("GetImg")?imageURL={{image_urls}}"  width="100" height="50"/>          
        </li>
    </ol>
</div>


            
                    </div>

                    <div class="modal-footer">

                        <span ng-show="advstatus">  <img ng-src="../images/hourglass.gif"  width="50" height="50">   </span>

                        {{log.length}}
                        @*  <span ng-repeat="stmt in log">{{ stmt }}<br/></span>*@
                        
                    </div>
                
               
               
               </div>
                  

                    </div> 

               </div> 




 @* panel body end*@
  </div>


 
  @* panel end*@
</div>
    
  
             
    
    @*controller end *@
     </div>

@section Scripts{
<script src="~/Scripts/Controllers/AlbumPublishController.js"></script>
}
