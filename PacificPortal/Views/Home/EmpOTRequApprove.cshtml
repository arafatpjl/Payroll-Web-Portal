@{
    ViewBag.Title = "OT Requisition Approve";
}
<style>
    body{
        margin-top:80px;   
    }


    input {
        /*max-width:400px;*/
    }
    .error {
    }


</style>



<div ng-controller="EmpOTRequApproveController"  class="container">

   <div class="panel panel-info" >

            <div class="panel-heading" style="min-height:80px">


                                    <div class="col-md-4 col-sm-6" >
             
          
                                            <div class="input-daterange input-group">

                                                    <span class="input-group-addon">Date :</span>

                                                    <div class="input-group date"  id="ScheduleDate" ng-model="ScheduleDate"  ng-blur="search_by()" ng-model-options='{ debounce: 1000 }' date-picker>
                                                    <input type="text" class="form-control" name="ScheduleDate"  ng-model="ScheduleDate"   ng-blur="search_by()" ng-model-options='{ debounce: 1000 }' date-picker-input>

                                                    <span class="input-group-addon">
                                                    <span class="glyphicon glyphicon-calendar"></span>                             
                                                    </span>
                                                    </div>
                                                     
                                                

                                            </div>


                                    </div>



                 
                <div class="col-md-4 col-sm-6" >
             
          
                                            <div class="input-daterange input-group">

                                                    <span class="input-group-addon">Unit </span>

                                                     <select ng-model="Company" class="form-control"  name="ComID" ng-options="I.Name for I in CompanyList | filter:{ID:ComID}:containsComparator" ng-change="search_by()" ng-class="submitted?'ng-dirty':''" required >
                                                        <option value="">Select Unit</option>
                  
                                                      </select>
                                                
                                            </select>  
                                                
                                               


                                            </div>


                                    </div>
               
                 
            </div>
 
         
               @*<button class="btn btn-success btn-xs" ng-show="loading"><i class="fa fa-spinner fa-spin"></i> Loading</button>*@

       <!-- progress bar info -->




      



   <div class="panel-body">

                <div class="row">
                     

         <div class="col-md-12 col-sm-6" style="min-height:20px" >

              
         
                      <div class="col-md-9 col-sm-6" >
               
              

                                      <div class="input-daterange input-group">

                                                <span class="input-group-addon" style="color:#3e9617;font-size:12px;font-weight:bold">
                                                  OT Requisition 
                                                </span>

                                          <span ng-show="!ApprovePermission"  class="input-group-addon" style="color:#3e9617;font-size:12px;font-weight:bold"> 
                                                      Publish  All 
                                               <input type="checkbox" ng-model="selectedAll_IsLock" ng-click="checkAll_IsLock()" />
                                                        
                                                                                  </span>

@*                                          <div    class="checkbox checkbox-primary  checkbox-circle">
                        <input type="checkbox" ng-model="selectedAll_IsLock" ng-click="checkAll_IsLock()" />
                        <label for="checkbox2">
                             Publish  All  
                        </label>
                    </div>*@


                                          
                              @{
                                  // Set LoginID
                                  if (ViewBag.UserInfo != null)
                                  {
                                      var UserInfo = ViewBag.UserInfo as IEnumerable<PacificPortal.Models.prc_EmployeeInfo_Result>;

                
                                   <input type="hidden"  ng-init="LoginID = '@UserInfo.FirstOrDefault().RegId'"  />    
                                  }
              
                                  }
                                       

                                                
                                          
                                          <span  ng-show="!ApprovePermission" class="input-group-addon" style="color:#3e9617;font-size:14px;font-weight:bold">
                                               <i style="cursor: pointer;"   ng-click="UpdateStatus(0)" class="glyphicon glyphicon-floppy-disk"></i>
                                              @* <i style="cursor: pointer;padding-left:5px"   ng-click="showReport()" class="glyphicon glyphicon-list"></i>*@
                                                  </span>
                                          
                                          <span ng-show="ApprovePermission" class="input-group-addon" style="color:#3e9617;font-size:12px;font-weight:bold">
                                                 Approve All  <input  type="checkbox" ng-model="selectedAll_Approved" ng-click="checkAll_Approved()" />
                                                </span>

                                           <span ng-show="ApprovePermission" class="input-group-addon" style="color:#3e9617;font-size:14px;font-weight:bold">
                                               <i style="cursor: pointer;"   ng-click="UpdateStatus(1)" class="glyphicon glyphicon-floppy-disk"></i>
                                               @*<i style="cursor: pointer;padding-left:5px"   ng-click="showReport()" class="glyphicon glyphicon-list"></i>*@
                                                  </span>
                                             <span class="input-group-addon" style="color:#3e9617;font-size:14px;font-weight:bold">
                                                 <i style="cursor: pointer;padding-left:5px"   ng-click="showReport()" class="glyphicon glyphicon-list"></i>
                                                 <i style="font-size:14px;color:#69a31e;cursor: pointer;" ng-show="SaveShow"  ng-click="OTRequ_update()" class="glyphicon glyphicon-floppy-disk"></i>
                                               
                      Saved :
                       <span class="badge" style="background-color:#69a31e;font-size:12px;font-weight:bold">
                                           {{Saved}} of ( {{ EmpList.length}} )

                                                </span>
                      
                                                </span>


                                            
                                       </div>


                 
                          <div style="overflow-y: scroll; max-height: 500px;">


                              <table id="Report_table" class="table">
                                  <thead>
                                      <tr>
                                          <th>Department</th>
                                          <th>Section</th>
                                          <th>Emp Type</th>
                                          <th>Requ. OT</th>
                                          <th>Total Emp</th>
                                          <th>Today OT</th>
                                          <th>Publish(HR)</th>
                                          <th ng-show="ApprovePermission">Approved</th>
                                          <th>Reasons</th>
                                          <th>Edit</th>
                                          <th>Detail</th>
                                      </tr>
                                  </thead>
                                  <tbody>
                                      @*<tr ng-repeat="r in EmpOTRequisitionList | orderBy : ['StartTime.Hours','StartTime.Minutes', 'Wstatus', 'RoadName', 'VehicleNo', 'Driver'] | filter: RoadFilter | filter: EmpTypeFilter|filter: {StartTime: {Hours: 18}}:true|filter: {StartTime: {Minutes: StartTimeFilter.split(':')[1]}}:exact as results"> 
      
        Department, Section, DesigAddi, EmpCode, DailyDate, Shift, OTStart, WeekNo, TotalWeekOT, WeekLimit, MonthNo, TotalMonthOT, MonthLimit
      *@
                                      <tr ng-model="available" ng-repeat="r in EmpList | orderBy :['Department', 'Section'] as results_EmpList">

                                          <td>{{r.Department}}</td>
                                          <td>{{r.Section}}</td>
                                          <td>{{r.Wstatus}}</td>
                                          <td>{{r.OTRequ}}</td>
                                          <td>{{r.TotalEmp}}</td>
                                          <td><a ng-class="getClasses(r.Approved)" ng-click="UpdateStatus2(r,r.Approved)"><span>{{r.TotalOT}}</span></a> </td>

                                          <td>
                                              <input type="checkbox" ng-model="r.IsLock">
                                          </td>

                                          <td ng-show="ApprovePermission">
                                              @*<a ng-class="getClasses(r.Approved)"  ng-click="UpdateStatus(r,r.Approved)"><span>{{r.Approved}}</span></a>*@
                                              <input type="checkbox" ng-model="r.Approved">
                                          </td>
                                          <td><a href="#0" title="{{r.Reasons}}" data-toggle="tooltip" data-placement="top" tooltip>{{ r.Reasons.length > 15 ? ((r.Reasons | limitTo:15) + "...") : r.Reasons }}</a></td>

                                          <td>
                                               <a href="#0" style="font-size: 10px; color: #69a31e" ng-click="editOTStatus(r)" data-toggle="modal" data-target="#ModaldataApprove" >Edit</a>
                                          </td>
                                          <td>
                                              <i style="font-size: 10px; color: #69a31e" ng-click="getRequInfoList(r)" data-toggle="modal" data-target="#Modaldata" class="glyphicon glyphicon-list"></i>
                                          </td>
                                      </tr>
                                  </tbody>


                              </table>

                          </div>    

                            </div>   

              <div class="col-md-3 col-sm-6" >
                 @* <span style="color:#1f530d;font-size:12px">    <i class="glyphicon glyphicon-hand-right"></i> Check and Click Save Button to Update Data </span>
                  *@

             
                           

                                                


          <table  id="Report_table"  class="table">
    <thead>
        <tr>
            <th></th>
             <th></th>            
        </tr>
    </thead>
    <tbody>
      @*<tr ng-repeat="r in EmpOTRequisitionList | orderBy : ['StartTime.Hours','StartTime.Minutes', 'Wstatus', 'RoadName', 'VehicleNo', 'Driver'] | filter: RoadFilter | filter: EmpTypeFilter|filter: {StartTime: {Hours: 18}}:true|filter: {StartTime: {Minutes: StartTimeFilter.split(':')[1]}}:exact as results"> 
      
        Department, Section, DesigAddi, EmpCode, DailyDate, Shift, OTStart, WeekNo, TotalWeekOT, WeekLimit, MonthNo, TotalMonthOT, MonthLimit
      *@
        <tr  ng-model="available" ng-repeat="r in EmpOTApprovePermissionList | orderBy :['ID']"> 
                      
            <td>{{r.EmpInfo}}</td>
             <td> <i style="font-size:14px;color:#ff6a00;cursor: pointer; " class="glyphicon glyphicon-envelope"  ng-click="mailto(r.EmailID,r.RegId)"></i>                
                                               </td>
             
           </tr>
    </tbody>


</table>

               </div>


                     <div class="col-md-12 col-sm-6" style="min-height:20px" >

                          <div class="col-md-5 col-sm-6" >
                            <span style="color:#3e9617;font-size:12px;font-weight:bold">
                                                 Department Wise Summary
                                                </span> 
                          <table  id="Report_table" class="table table-striped" style="font-family: monospace;">

                                <tr ng-repeat="(key, value) in results_EmpList | groupBy: 'Department' "  style="font-size:12px;color:#006DCC">
                               
                                         <td>
                                        {{ key }} 
                                        </td>

                                     <td>
                                       <div ng-repeat="(key_2, value_2) in  value| groupBy: 'Wstatus'">

                                         
                                            <i class="glyphicon glyphicon-user2" style="padding-left:20px;color:#b1d1d4"></i> 
                                           <span style="padding-left:10px">{{("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+ key_2 ).slice(-6)}} </span>

                                            <i class="glyphicon glyphicon-user" style="padding-left:20px;color:#b1d1d4"></i> 
                                        
                                            <span style="padding-left:10px">{{("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+ getEmpSum(value_2)).slice(-6)}} </span> 
                                         
                                           <i class="glyphicon glyphicon-time" style="padding-left:20px;color:#b1d1d4"></i> 
                                          <span style="padding-left:10px">{{ getHoursSum(value_2) }} </span> 
                                          
                                          </div>
                                        </td>

                                </tr>
                             </table>

                          </div>     
              
                          <div class="col-md-3 col-sm-6" >
                          <span style="color:#3e9617;font-size:12px;font-weight:bold">
                                                  Emp Wise Summary
                                                </span> 

                   <table  id="Report_table" class="table table-striped" style="font-family: monospace;">

                                <tr ng-repeat="(key, value) in results_EmpList | groupBy: 'Wstatus'"  style="font-size:12px;color:#006DCC">
                               
                                         <td>
                                        {{ key }} 
                                        </td>
                                 
                                        <td>
                                           @*  {{ value}}*@
                                            <i class="glyphicon glyphicon-user" style="padding-left:20px;color:#b1d1d4"></i> 
                                           <span style="padding-left:10px">{{("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+getEmpSum(value) ).slice(-6)}} </span>

                                           <i class="glyphicon glyphicon-time" style="padding-left:20px;color:#b1d1d4"></i> 
                                          <span style="padding-left:10px">{{getHoursSum(value)}} </span> 
                                           @*{{ longString | limitTo: 20 }} {{longString.length < 20 ? '' : '...'}}*@
                                        
                                        </td>

                                </tr>
                             </table>

                  </div>
             

                </div> 
             

             <div class="modal fade" id="Modaldata" role="dialog">
                 <div class="modal-dialog modal-lg">

                     <div class="panel panel-info">
                         <div class="panel-heading" style="text-align: center">
                             <button type="button" class="close" data-dismiss="modal">&times;</button>
                             Data : {{data.Department}} >> {{data.Section}}
                         </div>
                         <div class="modal-body">

                             <table id="Report_table" class="table">
                                 <thead>
                                     <tr>
                                         <th>Emp Code</th>
                                         <th>Name</th>
                                         <th>Desig.</th>
                                         <th>OT Start</th>
                                         <th>Week(OT)</th>
                                         <th>Month(OT)</th>
                                         <th>Today OT</th>


                                     </tr>
                                 </thead>
                                 <tbody>
                                     @*<tr ng-repeat="r in EmpOTRequisitionList | orderBy : ['StartTime.Hours','StartTime.Minutes', 'Wstatus', 'RoadName', 'VehicleNo', 'Driver'] | filter: RoadFilter | filter: EmpTypeFilter|filter: {StartTime: {Hours: 18}}:true|filter: {StartTime: {Minutes: StartTimeFilter.split(':')[1]}}:exact as results"> 
      
        Department, Section, DesigAddi, EmpCode, DailyDate, Shift, OTStart, WeekNo, TotalWeekOT, WeekLimit, MonthNo, TotalMonthOT, MonthLimit
      *@
                                     <tr ng-model="available" ng-repeat="r in RequInfoList | orderBy :['EmpCode', 'Name'] as Result_RequInfoList">

                                         <td>{{r.EmpCode}}</td>
                                         <td>{{r.Name}}..</td>
                                         <td>{{r.DesigAddi}}</td>
                                         <td>{{r.OTStart.slice(6,-2)|date:'hh:mm:ss a'}}</td>

                                         <td ng-style="r.WeekLimit === true ? { color:'red' } : { color:'green' }">{{r.TotalWeekOT}}</td>
                                         <td ng-style="r.MonthLimit === true ? { color:'red' } : { color:'green' }">{{r.TotalMonthOT}}</td>
                                         <td>{{r.OTRequ}}</td>




                                     </tr>
                                 </tbody>


                             </table>


                         </div>
                         <table id="Report_table" class="table table-striped">

                             <tr ng-repeat="(key, value) in Result_RequInfoList | groupBy: 'DesigAddi'" style="font-size: 12px; color: #006DCC">

                                 <td>{{ key }} 
                                 </td>

                                 <td>{{value.length}}
                                 </td>

                             </tr>
                         </table>

                     </div>

                 </div>
             </div>


 <!-- --------------------------END Model--------------------------------- -->

             <!-- --------------------------Strat Model2--------------------------------- -->

             <div class="modal fade" id="ModaldataApprove" role="dialog">
                 <div class="modal-dialog">
                     <div class="col-sm-8 col-sm-offset-3">
                     <div class="panel panel-info">
                         <div class="panel-heading" style="text-align: center">
                             <button type="button" class="close" data-dismiss="modal">&times;</button>
                             OT Requisition Update
                         </div>
                        <div class="modal-body"  >

                            <form novalidate name="f1" ng-submit="OTApproveEdit(Approvedata)" style="padding: 10px 10px 10px 30px;">



                                <table class="table">
                                    <tbody>

                                        <tr>
                                            <td>Department :</td>
                                            <td>{{Approvedata.Department}}</td>
                                        </tr>

                                        <tr>
                                            <td>Section :</td>
                                            <td>{{Approvedata.Section}}</td>
                                        </tr>


@*                                        <tr>
                                            <td>Date :</td>
                                            <td>{{Approvedata.Date  | date:'MM/dd/yyyy'}}</td>
                                        </tr>*@

                                        

                                        <tr>
                                            <td>Ot Hours :</td>
                                            <td>

                                                <input type="text" ng-model="Approvedata.OTRequ" ng-blur="Approvedata.OTRequ =check_time(Approvedata.OTRequ)"  class=" form-control  input-sm" name="OTRequ"  />

                                            </td>
                                        </tr>



                                        <tr>
                                            <td>Reasons</td>
                                            <td>
                                                <textarea cols="30" name="textarea" ng-model="Approvedata.EditReasons"></textarea>
                                            </td>
                                        </tr>



                                    </tbody>
                                </table>



                                <div class="text-center">
                                    <input type="submit" class="btn btn-primary" value="{{submitText}}" />
                                </div>


                            </form>

                    </div>



                         <table id="Report_table" class="table table-striped">

                             <tr ng-repeat="(key, value) in Result_RequInfoList | groupBy: 'DesigAddi'" style="font-size: 12px; color: #006DCC">

                                 <td>{{ key }} 
                                 </td>

                                 <td>{{value.length}}
                                 </td>

                             </tr>
                         </table>

                     </div>

                 </div>
                 </div>
             </div>

             <!-- --------------------------END Model2--------------------------------- -->


 @* row end*@
  </div>


                  
 @* panel body end*@
  </div>


 
  @* panel end*@
</div>
    
    
    
    @*controller end *@
     </div>
   
    

@section Scripts{
<script src="~/Scripts/Controllers/EmpOTRequApproveController.js"></script>
}
