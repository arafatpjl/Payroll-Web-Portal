@{
    ViewBag.Title = "Recovery Password";
}
<style>
    body{
        margin-top:50px;       
    }


    input {
        /*max-width:400px;*/
    }
    .error {
        color: red;
    }

    

.row div {
    background-color:#bedae5;    
    white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-block;
        max-width: 100%;
}

.row:nth-of-type(2n) div { 
        background: #0094ff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-block;
        max-width: 100%;
    }


/*.row div {
     background: #eee;
   }

  .row div:nth-of-type(2n) {
     background: #fff;
   }*/


</style>



<div ng-controller="RecoveryPasswordController"  style="padding-top:20px"  class="container">

        
    <div class="col-sm-10 col-sm-offset-3">

        <div class="panel panel-info"  style="margin-top:50px;max-width:500px;">
            <div class="panel-heading">
               Recovery Password
            </div>

                    
               <form novalidate name="f1" ng-submit="RecoveryPassword(User)" style="padding:10px 30px 10px 30px;">    
         


             <div class="form-group">
                <label class="text text-info">Unit : </label> 
             
                <select ng-model="Company" class="form-control"  name="ComID" ng-options="I.Name for I in CompanyList" ng-change="GetCompID()" ng-class="submitted?'ng-dirty':''" required >
                <option value="">Select Unit</option>
                  
              </select>
               
        
                 <span class="error col-md-offset-2"  ng-show="(f1.ComID.$dirty || submitted) && f1.ComID.$error.required">Unit required!</span>
                
                            </div>



            <div class="form-group">
                <label class="text text-info">Login ID : </label>
                <input type="text" ng-model="User.EmployeeCode" class="form-control" name="EmployeeCode" ng-class="submitted?'ng-dirty':''" required />
                 <span class="error col-md-offset-2"  ng-show="(f1.EmployeeCode.$dirty || submitted) && f1.EmployeeCode.$error.required">Username required!</span>
            </div>



           <div class="form-group">
               <label class="text text-info">Date Of Birth: </label>
              
               <div class="input-group date" id="birthdate"   ng-model="User.DateofBirth" date-picker>
         <input type="text" name="uDateofBirth" class="form-control   input-sm"  date-picker-input ng-model="User.DateofBirth" data-date-view-mode="years"  ng-class="submitted?'ng-dirty':''" required >

         <span class="input-group-addon">
           <span class="glyphicon glyphicon-calendar"></span>
         </span>
       </div>
                <span class="error col-md-offset-2" ng-show="(f1.uDateofBirth.$dirty || submitted) && f1.uDateofBirth.$error.required">Birth Date required!</span>
           
                   
            </div>


           
              <div class="text-center"> 
                <input type="submit" class="btn btn-primary" value="{{submitText}}" />
            </div>

                
        </form>


     <div class="panel-footer">
               
         <a href="#" style="margin-left:80px;">@Html.ActionLink("Sign In ", "")</a>
                
    
    </div>

   
      </div>

    </div> 
        </div> 

@section Scripts{
<script src="~/Scripts/Controllers/RecoveryPasswordController.js"></script>
}
