@{
    ViewBag.Title = "OT Requisition Summary";
}


<style>
    html {
        /*width: 21cm;
        height: 29.7cm;
        overflow: scroll;*/
        }

      body {
            background: rgb(204,204,204);
            }

page[size="A4"] {
  background: white;
  width: 21cm;
  height: 29.7cm;
  display: block;
  margin: 0 auto;
  margin-bottom: 0.5cm;
  box-shadow: 0 0 0.5cm rgba(0,0,0,0.5);
   padding-left:10px;
}
@@media print {
  body, page[size="A4"] {
    margin: 0;
    box-shadow: 0;
  }
}


</style>



<div ng-controller="EmpOTRequisitionController"  class="container">

      <page size="A4">

   <div class="row vdivide" >
                    <div class="text-center" >
                        {{Company[0].Name}}   
                        <br/>
                  OT Requisition Report  {{data.Date|date:'dd-MM-yyyy'}} 
                        <br/>
                        {{OTReq[0].RequeType}}
                    </div>
          </div>

        <hr>


           <div class="row vdivide">
            
            <div class="col-sm-6">

                <span style="color:#3e9617;font-size:12px;font-weight:bold">
                                                  Emp Wise Summary
                                                </span> 

                   <table  id="Report_table" class="table table-striped" style="font-family: monospace;">

                                <tr ng-repeat="(key, value) in results_ApproveSummaryList | groupBy: 'WStatus'"  style="font-size:12px;color:#006DCC">
                               
                                         <td>
                                        {{ key }} 
                                        </td>
                                 
                                        <td>
                                           @*  {{ value}}*@
                                            <i class="glyphicon glyphicon-user" style="padding-left:20px;color:#b1d1d4"></i> 
                                           <span style="padding-left:10px">{{("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+getEmpSum(value) ).slice(-6)}} </span>

                                           <i class="glyphicon glyphicon-time" style="padding-left:20px;color:#b1d1d4"></i> 
                                          <span style="padding-left:10px">{{getHoursSum(value)}} </span> 
                                           @*{{ longString | limitTo: 20 }} {{longString.length < 20 ? '' : '...'}}*@
                                        
                                        </td>

                                </tr>
                             </table>
            </div>
          </div>


                     
  <div class="row vdivide">
    
       <div class="col-sm-12" >
            <span class="label label-info">Detail</span>   
              
              

                              
        <table  id="Report_table" class="table table-striped">
    <thead>
        <tr>
            <th>Empcode</th>
             <th>Name</th>
            <th>Designation</th> 
            <th>Wstatus</th>  
            <th>Department</th> 
            <th>Section</th>            
            <th>Actual OT</th>
            <th>Req OT </th>
           
        </tr>
    </thead>
    <tbody>
      @*<tr ng-repeat="r in EmpOTRequisitionList | orderBy : ['StartTime.Hours','StartTime.Minutes', 'Wstatus', 'RoadName', 'VehicleNo', 'Driver'] | filter: RoadFilter | filter: EmpTypeFilter|filter: {StartTime: {Hours: 18}}:true|filter: {StartTime: {Minutes: StartTimeFilter.split(':')[1]}}:exact as results"> 
      
        Department, Section, DesigAddi, EmpCode, DailyDate, Shift, OTStart, WeekNo, TotalWeekOT, WeekLimit, MonthNo, TotalMonthOT, MonthLimit
      *@
        <tr   ng-repeat="r in EmpOTApproveSummaryList |  orderBy :['Section','EmpCode', 'Name'] as results_ApproveSummaryList "> 
                      
            <td>{{r.EmpCode}}</td>
             <td>{{r.Name}}</td>
             <td>{{r.Designation}}</td>
             <td>{{r.WStatus}}</td>
            <td>{{r.Department}}</td>
             <td>{{r.Section}}</td>
             <td>{{r.OT}}</td>
             <td>{{r.OTReque}}</td>>
           
           </tr>
    </tbody>


</table>
             
                    </div>
        </div>

                    

      

    
      </page>
    
    @*controller end *@
     </div>
   
   

@section Scripts{
<script src="~/Scripts/Controllers/EmpOTRequisitionController.js"></script>
}
