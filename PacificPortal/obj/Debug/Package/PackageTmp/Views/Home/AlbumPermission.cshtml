@{
    ViewBag.Title = "Album Permission";
}
<style>


    body{
        margin-top:50px;
    }
    input {
        /*max-width:400px;*/
    }
    .error {
        color: red;
    }

</style>

                       

    <div ng-controller="AlbumPermissionController" style="padding-top:20px"  class="container">
             

      
        
          <div class="modal fade" id="ModalAlbumNew" role="dialog"  >
            <div class="modal-dialog modal-lg"  >
                  <div class="col-sm-10 col-sm-offset-3">
               <div class="panel panel-info" >
                    <div class="panel-heading" style="text-align:center">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>                      
                        {{ModelTile}}                           
                    </div>
                    <div class="modal-body"  >

      
                         <form novalidate name="f1" >   
        
                        <div class="form-group">
                            <label class="text text-info">Album Group Name: </label>                              
                            <input type="text" ng-model="AlbumGroup.GroupName" class="form-control" name="GroupName"/>
                            <span class="error col-md-offset-2" ng-show="(f1.GroupName.$dirty || submitted) && f1.GroupName.$error.required">Reasons require</span>
                        </div>

                              <div class="form-group">
                            <label class="text text-info">Security Code: </label>                              
                            <input type="text" ng-model="AlbumGroup.SecurityCode" class="form-control" name="SecurityCode"/>
                            <span class="error col-md-offset-2" ng-show="(f1.SecurityCode.$dirty || submitted) && f1.SecurityCode.$error.required">Reasons require</span>
                        </div>


                              <div class="form-group">
                             <div class="text-center"> 
                            <input type="submit" class="btn btn-primary" ng-click="SaveGroup(AlbumGroup)" value="{{button}}"  />   
                             <input type="submit" ng-show="button=='Update'" class="btn btn-success" ng-click="AlbumPreview(AlbumGroup.ID)" value="Preview" /> 
                        </div>
 </div>

                             <div class="row">
                             
				<div class="col-xs-5">
                     <select class="form-control formcls" size="13" multiple="multiple" ng-model="available" ng-options="Album as Album.Name for Album in AvailableAlbum" ></select>

				</div>

				
				<div class="col-xs-1">
					@*<button type="button" id="lstview_undo" class="btn btn-danger btn-block">undo</button>*@
					
                    <button type="button" id="lstview_rightAll" class="btn btn-primary btn-block" ng-click="moveAll(AvailableAlbum,selectedAlbum)"><i class="glyphicon glyphicon-forward" ></i></button>
					<button type="button" id="lstview_rightSelected" class="btn btn-success btn-block" ng-click="moveItem(available, AvailableAlbum,selectedAlbum)" ><i class="glyphicon glyphicon-chevron-right"></i></button>
					<button type="button" id="lstview_leftSelected" class="btn btn-success btn-block"  ng-click="moveItem(selected, selectedAlbum,AvailableAlbum)"><i class="glyphicon glyphicon-chevron-left"></i></button>
					<button type="button" id="lstview_leftAll" class="btn btn-primary btn-block" ng-click="moveAll(selectedAlbum,AvailableAlbum)"><i class="glyphicon glyphicon-backward"></i></button>
					
                    @*<button type="button" id="lstview_redo" class="btn btn-warning btn-block">redo</button>*@
				</div>
				
				<div class="col-xs-5">
				 <select class="form-control formcls" size="13" multiple="multiple" ng-model="selected"  ng-options="Album as Album.Name for Album in selectedAlbum" ></select>
            		</div>

                                

                 
</div>
                       
                
        </form>
                        
                    </div>
                    
                </div>
                       </div>
            </div>
        </div>




        <div class="panel-footer modal_custom">        
           
  <input type="submit" class="btn btn-success"data-toggle="modal" ng-click="AlbumCreate()" value="Create New Group" />

            <div class="row">


                <div class="col-xs-12">
                     <select class="form-control formcls" size="13" multiple="multiple" ng-model="AlbumGroup" ng-change="AlbumChange()"  ng-options="AlbumGroup as AlbumGroup.GroupName for AlbumGroup in AlbumGrouplist" ></select>

				</div>


                 <div style="clear:both">
   @* <br/>
    <div>Selected Album: {{selectedAlbum}}</div>
    <div>Available Album: {{AvailableAlbum}}</div>
    <div>Selected: {{selected}}</div>
    <div>Available: {{available}}</div>*@
  </div>
        

			</div>


    </div> 



       </div>  

@section Scripts{
<script src="~/Scripts/Controllers/AlbumPermissionController.js"></script>
}
