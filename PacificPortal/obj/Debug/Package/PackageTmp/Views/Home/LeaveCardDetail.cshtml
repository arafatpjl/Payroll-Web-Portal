@{
    ViewBag.Title = "Leave Information";
}

<style>

    html {
        /*width: 21cm;
        height: 29.7cm;
        overflow: scroll;*/
        }

      body {
            background: rgb(204,204,204);
            }

page[size="A4"] {
  background: white;
  width: 21cm;
  height: 29.7cm;
  display: block;
  margin: 0 auto;
  margin-bottom: 0.5cm;
  box-shadow: 0 0 0.5cm rgba(0,0,0,0.5);
   padding-left:10px;
}
@@media print {
  body, page[size="A4"] {
    margin: 0;
    box-shadow: 0;
  }
}


    #Report_table {
       font-size: 11px;
/*text-align:center;*/
/*white-space: nowrap;*/ 
    }

#Report_table >tbody>tr>td{
  height:20px;
  padding:0px;
  border-top: 0px;

  padding-left:5px;
}


.row.vdivide [class*='col-']:not(:last-child):after {
  background: #e0e0e0;
  width: 1px;
  content: "";
  display:block;
  position: absolute;
  top:0;
  bottom: 0;
  right: 0;
  min-height: 70px;
 
}

</style>


    <div ng-controller="LeaveCardDetailController" style="height:23cm; width:100%; overflow:auto;" ng-cloak>

       
        <page size="A4">

@*             <div class="row text-center"> 
                  
                
