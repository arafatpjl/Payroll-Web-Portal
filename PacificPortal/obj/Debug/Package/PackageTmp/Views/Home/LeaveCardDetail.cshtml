           <div class="row vdivide">
                    <div class="text-center">

                  <h4> Employee Leave  Information  {{LeaveCardParameter.Year}} </h4>
                    </div>
          </div>

        <hr>


          <div class="row vdivide">
            <div class="col-sm-6" >

                 <p> EMP CODE :  <span><strong>{{EmployeeDetail.EmployeeCode}}</strong> </span> </p>
                                <p> Name : <span><strong>{{EmployeeDetail.Name}}</strong> </span> </p>
                                <p> Department :  <span><strong>{{EmployeeDetail.Department}}</strong> </span> </p>
                                <p> Section : <span><strong>{{EmployeeDetail.Section}}</strong> </span> </p>
                                <p> Designation :  <span><strong>{{EmployeeDetail.Designation}}</strong> </span> </p> 

            </div>
            <div class="col-sm-6 text-center">

                 <span class="label label-info">Leave Enjoy Summary Year Of {{LeaveCardParameter.Year}}</span>

                             <table   class="table">
                    <thead>
                        <tr>
                            <th>Leave Type</th>
                            <th>Total</th>
                            <th>Enjoy</th>
                            <th>Balance</th>
            
                        </tr>
                    </thead>
                    <tbody >
                         <tr ng-repeat="r in LeaveSummaryList">        
                            <td>{{r.LeaveType}}</td>
                            <td>{{r.Total}}</td>
                            <td>{{r.Enjoy}}</td>
                            <td>{{r.Balance}}</td>
            
                        </tr>       
        
                    </tbody>
                </table>
            </div>
          </div>




  <div class="row vdivide">
    
       <div class="col-sm-12" >
            <span class="label label-info">Leave Enjoy Detail Year Of {{LeaveCardParameter.Year}}</span>
                          
        <table  id="Report_table" class="table table-striped">

           
            <thead>
                <tr>
                    <th>
                        From
                    </th>

                    <th>
                        To
                    </th>
                    <th>
                       Leave Type
                    </th>
                    <th>
                        Leave Days
                    </th>
                   
                    <th>
                        Reasons
                    </th>
                   
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="i in LeaveCardDetails">

                      <td>{{i.FrDate.slice(6,-2)|date:'dd-MM-yyyy'}}</td> 
                    <td>{{i.ToDate.slice(6,-2)|date:'dd-MM-yyyy'}}</td> 
                                        
                    <td>{{i.LType}}</td>
                    <td>{{i.LDays}}</td>
                    <td></td>
                    
                </tr>
            </tbody>
        </table>
  </div>
        </div>
<hr>



                
                  <div role="separator" class="divider"></div>
                    <div class="col-xs-3">

                    </div>

                </div>


                    

            




           
          


        </page>



</div>

                  
               
