@{
    ViewBag.Title = "OT Requisition Approve";
}


<style>
    html {
        /*width: 21cm;
        height: 29.7cm;
        overflow: scroll;*/
        }

      body {
            background: rgb(204,204,204);
            }

page[size="A4"] {
  background: white;
  width: 21cm;
  height: 29.7cm;
  display: block;
  margin: 0 auto;
  margin-bottom: 0.5cm;
  box-shadow: 0 0 0.5cm rgba(0,0,0,0.5);
   padding-left:10px;
}
@@media print {
  body, page[size="A4"] {
    margin: 0;
    box-shadow: 0;
  }
}


</style>



<div ng-controller="EmpOTRequApproveController"  class="container">

      <page size="A4">

   <div class="row vdivide" >
                    <div class="text-center" >
                           {{Company[0].Name}}
                        <br/>
                  OT Requisition Report  {{data.Date|date:'dd-MM-yyyy'}} 
                    </div>
          </div>

        <hr>


           <div class="row vdivide">
            <div class="col-sm-6" >

                   <span style="color:#3e9617;font-size:12px;font-weight:bold">
                                                 Department Wise Summary
                                                </span> 
                          <table  id="Report_table" class="table table-striped" style="font-family: monospace;">

                                <tr ng-repeat="(key, value) in results_EmpList | groupBy: 'Department' "  style="font-size:12px;color:#006DCC">
                               
                                         <td>
                                        {{ key }} 
                                        </td>

                                     <td>
                                       <div ng-repeat="(key_2, value_2) in  value| groupBy: 'Wstatus'">

                                         
                                            <i class="glyphicon glyphicon-user2" style="padding-left:20px;color:#b1d1d4"></i> 
                                           <span style="padding-left:10px">{{("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+ key_2 ).slice(-6)}} </span>

                                            <i class="glyphicon glyphicon-user" style="padding-left:20px;color:#b1d1d4"></i> 
                                        
                                            <span style="padding-left:10px">{{("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+ getEmpSum(value_2)).slice(-6)}} </span> 
                                         
                                           <i class="glyphicon glyphicon-time" style="padding-left:20px;color:#b1d1d4"></i> 
                                          <span style="padding-left:10px">{{ getHoursSum(value_2) }} </span> 
                                          
                                          </div>
                                        </td>

                                </tr>
                             </table>

            </div>
            <div class="col-sm-6">

                <span style="color:#3e9617;font-size:12px;font-weight:bold">
                                                  Emp Wise Summary
                                                </span> 

                   <table  id="Report_table" class="table table-striped" style="font-family: monospace;">

                                <tr ng-repeat="(key, value) in results_EmpList | groupBy: 'Wstatus'"  style="font-size:12px;color:#006DCC">
                               
                                         <td>
                                        {{ key }} 
                                        </td>
                                 
                                        <td>
                                           @*  {{ value}}*@
                                            <i class="glyphicon glyphicon-user" style="padding-left:20px;color:#b1d1d4"></i> 
                                           <span style="padding-left:10px">{{("&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+getEmpSum(value) ).slice(-6)}} </span>

                                           <i class="glyphicon glyphicon-time" style="padding-left:20px;color:#b1d1d4"></i> 
                                          <span style="padding-left:10px">{{getHoursSum(value)}} </span> 
                                           @*{{ longString | limitTo: 20 }} {{longString.length < 20 ? '' : '...'}}*@
                                        
                                        </td>

                                </tr>
                             </table>
            </div>
          </div>


                     
  <div class="row vdivide">
    
       <div class="col-sm-12" >
            <span class="label label-info">Detail</span>   
              
              

                              
        <table  id="Report_table" class="table table-striped">
    <thead>
        <tr>
            <th>Department</th>
             <th>Section</th>
            <th>Emp Type</th>  
            <th>Requ. OT</th> 
            <th>Total Emp</th>            
            <th>Today OT</th>
           
        </tr>
    </thead>
    <tbody>
      @*<tr ng-repeat="r in EmpOTRequisitionList | orderBy : ['StartTime.Hours','StartTime.Minutes', 'Wstatus', 'RoadName', 'VehicleNo', 'Driver'] | filter: RoadFilter | filter: EmpTypeFilter|filter: {StartTime: {Hours: 18}}:true|filter: {StartTime: {Minutes: StartTimeFilter.split(':')[1]}}:exact as results"> 
      
        Department, Section, DesigAddi, EmpCode, DailyDate, Shift, OTStart, WeekNo, TotalWeekOT, WeekLimit, MonthNo, TotalMonthOT, MonthLimit
      *@
        <tr  ng-model="available" ng-repeat="r in EmpList | orderBy :['Department', 'Section'] as results_EmpList"> 
                      
            <td>{{r.Department}}</td>
             <td>{{r.Section}}</td>
             <td>{{r.Wstatus}}</td>
             <td>{{r.OTRequ}}</td>
           <td>{{r.TotalEmp}}</td>
            <td>{{r.TotalOT}}</td>
           
           </tr>
    </tbody>


</table>
             
                    </div>
        </div>

                    

      

    
      </page>
    
    @*controller end *@
     </div>
   
   

@section Scripts{
<script src="~/Scripts/Controllers/EmpOTRequApproveController.js"></script>
}
