@{
    ViewBag.Title = "Album Admin";
}

<style>
    body{
        margin-top:80px;   
    }


    input {
        /*max-width:400px;*/
    }
    .error {
        color: red;
    }

    


                        </style>
              




<div ng-controller="AlbumAdminController"  class="container">

   <div class="panel panel-info" >

            <div class="panel-heading" style="min-height:80px">



                <div class="col-md-12 col-sm-6" >
                       <div class="input-daterange input-group">
                    <span class="input-group-addon">  Search </span>   
                       <input type="text" class="search-query form-control" ng-change="search_by()" ng-model-options='{ debounce: 1000 }' ng-model="NameSearch"  placeholder="Album Name" />
                               <span class="input-group-addon">  Date </span>  
                    <div class="input-group date"  id="searchDate" ng-model="searchDate"  ng-blur="search_by()" ng-model-options='{ debounce: 1000 }' date-picker>
                         <input type="text" class="form-control netto-input" name="searchDate"  ng-model="searchDate"   ng-blur="search_by()" ng-model-options='{ debounce: 1000 }' date-picker-input>

                         <span class="input-group-addon">
                          <span class="glyphicon glyphicon-calendar"></span>                             
                         </span>
                                   
                       </div>
                            <span class="input-group-addon">    {{AlbumDetailList.length}} </span>  
                            <input type="submit" class="form-control btn-success"   ng-click="NewAlbumDialog()" value="Create New Album" />
                             <span class="input-group-addon"> </span>
                           <a  class="form-control btn-primary"  href="AlbumPermission">Album Permission</a>

                           </div> 
                     </div>

               
                

                 
        
          
              

                @*style="border:1px solid #4ec9d5;"*@ 

                    <div class="row" id="rowSearchType"> 
                    <div class="col-xs-12">

                        <div class="col-xs-3" ng-repeat="(key,value) in search">
                             
                                 {{key}}  :  <span style="color: #091f72">{{value}} </span>
                            <button type="button" class="close" ng-click="removeSearchType(key,value)">&times;</button>

                          
                            
                        </div>
                    </div>

 </div>
        

                </br>
                 
            </div>
 
         
               @*<button class="btn btn-success btn-xs" ng-show="loading"><i class="fa fa-spinner fa-spin"></i> Loading</button>*@

       <!-- progress bar info -->



       <!-- Modal --> <!-- --------------------------   New Album  --------------------------------- -->


          <div class="modal fade" id="ModalAlbumNew" role="dialog"  >
            <div class="modal-dialog">
                  <div class="col-sm-10 col-sm-offset-3">
               <div class="panel panel-info" >
                    <div class="panel-heading" style="text-align:center">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                       New Album
                    </div>
                    <div class="modal-body">

      
                         <form novalidate name="f1" ng-submit="CreateNewAlbum(Album)" >   
        
                        <div class="form-group">
                            <label class="text text-info">Album Name: </label>                              
                            <input type="text" ng-model="Album.Name" class="form-control" name="Name"/>
                            <span class="error col-md-offset-2" ng-show="(f1.Name.$dirty || submitted) && f1.Name.$error.required">Reasons require</span>
                        </div>
                         
                       <div class="form-group">
                            <label class="text text-info">Album Description: </label>                              
                              <textarea name="Reasons" class="form-control netto-input"  ng-model="Album.Description" required autofocus /> </textarea>
                            <span class="error col-md-offset-2" ng-show="(f1.Description.$dirty || submitted) && f1.Description.$error.required">Reasons require</span>
                        </div>    


                        <div class="form-group">
                            <label class="text text-info">Date: </label>                              
                             <div class="input-group date"  id="SnapDate" ng-model="Album.SnapDate" date-picker>
                         <input type="text" class="form-control netto-input" name="SnapDate"  ng-model="Album.SnapDate"  date-picker-input>

                         <span class="input-group-addon">
                          <span class="glyphicon glyphicon-calendar"></span>                             
                         </span>
                                   
                       </div>

                        </div> 


                        <div class="text-center"> 
                             <input type="submit" class="btn btn-primary" value="Create"  />             
                        </div>
                
        </form>
                        
                    </div>
                    
                </div>
                       </div>
            </div>
        </div>


      
         


   <div class="panel-body">

                       
    @*<label for="primary" class="btn btn-info">Level <input type="checkbox" ng-change="DesigShowChange()" ng-model="DesigShow" id="primary" class="badgebox"><span class="badge">&check;</span></label>
   *@
 
      <div class="row" infinityscroll="NextLoad()" style="height:500px; overflow:auto;padding-left:150px"> 

   
    @*  <div  class="col-xs-12" ng-repeat="(key,value) in (results_groupBy  = (AlbumDetailList |   orderBy : '-SnapDate'|   filter: search))|   orderBy : '-SnapDate'|  groupBy:'SnapDate' ">
      
      
            </br>
              <label for="primary" class="btn btn-info">Date :<span class="badge">{{key.slice(6,-2)|date:'dd-MM-yyyy'}}</span></label>
   
                  </br>*@

        
  <div class="col-xs-8" id="rowSearchData"   ng-repeat="AlbumDetail in AlbumDetailList|  orderBy : '-SnapDate'" >
       </br>

      <i class="glyphicon glyphicon-plus"></i>

                <span style="padding-left:5px">{{AlbumDetail.SnapDate.slice(6,-2)|date:'dd-MM-yyyy'}} 
                    </span>
     <span style="padding-left:10px;color:#091f72;font-size:14px"> {{AlbumDetail.Name}}</span>
         </br>
                  </br>
        <span style="padding-left:10px;color:#6b66ef">{{AlbumDetail.Description}}</span> 
      
       
           @*   <label for="primary" class="btn btn-info">Date :<span class="badge">{{AlbumDetail.SnapDate.slice(6,-2)|date:'dd-MM-yyyy'}}</span></label>
    <h5><span style="padding-left:10px;">{{AlbumDetail.Name}}</span></h5> *@ 
     

   @*entrepreneurs   ng-src="../images/album/blank-picture.png"*@
      <img  check-image  ng-src="@Url.Action("GetImg")?imageURL={{AlbumDetail.TemplateImage}}"  ng-click="SlideShow(AlbumDetail)"  class="card-img-top img-rounded img-responsive" style="margin:0 auto;cursor: pointer;" alt="Album Image" min-width="150" min-height="150"> 
       
       
           

  </div>


    


       
        
  </div>


 @* row end*@
  </div>



        @*id="{{AlbumDetail.RegId+'ModalShowImageSlide'}}"*@
             <!-- Modal --> <!-- --------------------------ModalShowImageSlide--------------------------------- -->
        <div class="modal fade" id="ModalShowImageSlide"  role="dialog"  >
            <div class="modal-dialog modal-lg" style="min-height:1000px">
               <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
               <div class="panel panel-info"  >
                    <div class="panel-heading" style="text-align:center">
                        <button type="button" class="close" data-dismiss="modal" >&times;</button>
                          
                        {{Album.Name}}
                        
                                           
                    </div>


                    <div class="modal-body">                       

                        <div id='carousel-custom' class='carousel slide' data-ride='carousel'>

           

    <div class='carousel-outer'>
          

        <!-- Wrapper for slides -->
        <div class='carousel-inner'>
          @*
            <div class='item active'>
                <img src='http://azoom-sites.rockthemes.net/abboxed/wp-content/uploads/sites/14/2015/05/abboxed-restaurant-portfolio2.jpg' alt='' />
            </div>
            
            <div class='item'>
                <img src='http://azoom-sites.rockthemes.net/abboxed/wp-content/uploads/sites/14/2015/05/abboxed-beach-portfolio.jpg' alt='' />
            </div>*@
            <div ng-class="({{$index}}==0) ? 'item active':'item'"   ng-repeat="image_urls in AlbumImagesList">
                
                <ol class="right carousel-indicators" style="padding-left:200px;margin-top:-0px">
                        <i ng-click="ZoomImage(image_urls)"  class="glyphicon glyphicon-zoom-in" style="padding-left:20px;color:#4ec9d5;cursor: pointer;font-size:14px "></i>
                        <i ng-click="TemplateImage(image_urls)"  class="glyphicon glyphicon-film" style="padding-left:20px;color:#4ec9d5;cursor: pointer;font-size:14px"></i>              
                        <i ng-click="DeleteImage(image_urls)"  class="glyphicon glyphicon-trash" style="padding-left:20px;color:#4ec9d5;cursor: pointer;font-size:14px"></i>
                </ol>

                  <div  style="width:800px;height:500px; overflow:auto;">
                @*<img src='{{image_urls}}' alt='' />*@
                 <img src="@Url.Action("GetImg")?imageURL={{image_urls}}"  width="800" height="500" />
                      </div
            </div>
                
           
        </div>
            
        <!-- Controls -->

         
        <a class='left carousel-control' href='#carousel-custom' data-slide='prev'>
           <span class="icon-prev" aria-hidden="true"></span>
        			<span class="sr-only">Previous</span>
        </a>
        <a class='right carousel-control' href='#carousel-custom' data-slide='next'>
          <span class="icon-next" aria-hidden="true"></span>
        			<span class="sr-only">Next</span>
        </a>

       

    </div>
    
    <!-- Indicators -->
    <ol class='carousel-indicators mCustomScrollbar'>
       @* <li data-target='#carousel-custom' data-slide-to='0' class='active'><img src='http://placehold.it/100x50&text=slide1' alt='' /></li>
        
        <li data-target='#carousel-custom' data-slide-to='1'><img src='http://placehold.it/100x50&text=slide2' alt='' /></li>*@
        

        <li data-target='#carousel-custom' ng-class="({{$index}}=={{$index}}) ? 'active'" data-slide-to='{{$index}}' ng-repeat="image_urls in AlbumImagesList">
             <img src="@Url.Action("GetImg")?imageURL={{image_urls}}"  width="100" height="50"/>          
        </li>
    </ol>
</div>


            
                    </div>
                    <div class="modal-footer">
                         <span class="label label-success" style="text-align: center;"> Upload New Image:</span>
                      
                        <span ng-show="advstatus">  <img ng-src="../images/hourglass.gif"  width="20" height="20">   </span>

                        <div ng-repeat="images in imagesList">
                            {{images.Name}} >>  {{images.size}} KB >>   {{images.Status}}
                            </div>

                        <div class="fileUpload btn btn-primary">
                            <span class="glyphicon glyphicon-file"></span>
                            <input type="file" class="upload"  ng-file-select="onFileSelect($files)"  custom-on-change="uploadFile" name="AlbumPic"  ng-model="AlbumPic" multiple>      
                        </div>

                        <br/>
                       
                         <input type="text" ng-change="UpdateAlbum()" ng-model="Album.Name" class="form-control" name="Name" ng-model-options='{ debounce: 1000 }' placeholder = "Name"/>
                         <textarea name="textarea"  ng-change="UpdateAlbum()" ng-model="Album.Description" class="form-control"  ng-model-options='{ debounce: 1000 }' placeholder = "Description" ></textarea>
                         <div class="input-group date"  id="SnapDate" ng-model="Album.SnapDate" ng-blur="UpdateAlbum()" date-picker>
                         <input type="text" class="form-control netto-input" name="SnapDate"  ng-model="Album.SnapDate"  ng-blur="UpdateAlbum()" ng-model-options='{ debounce: 1000 }' date-picker-input>

                         <span class="input-group-addon">
                          <span class="glyphicon glyphicon-calendar"></span>                             
                         </span>
                                   
                       </div>
                        
                    </div>
                </div>
                   </div>

                    </div> 

               </div> 




 @* panel body end*@
  </div>


 
  @* panel end*@
</div>
    
    
    
    @*controller end *@
     </div>
   
    

@section Scripts{
<script src="~/Scripts/Controllers/AlbumAdminController.js"></script>
}
